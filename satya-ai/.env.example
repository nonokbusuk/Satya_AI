# Copy to .env and replace every placeholder before starting the service.
# Generate independent random values, for example with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SATYA_AGENT_KEYS=replace-with-a-random-agent-key-at-least-32-chars
AUDIT_SECRET=replace-with-an-independent-random-audit-secret-at-least-32-chars
POSTGRES_USER=satya
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=satya
DATABASE_URL=postgresql+asyncpg://satya:replace-with-a-unique-database-password@postgres:5432/satya
